<odoo>
    <record
        id="pos_payment_method_view_form_inherit_payworld_wallee"
        model="ir.ui.view"
    >
        <field name="name">pos.payment.method.form.inherit.payworld.wallee</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field
                    name="wallee_space_id"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')], 'required': [('use_payment_terminal', '=', 'payworld_wallee')]}"
                />
                <field
                    name="wallee_api_host"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')]}"
                />
                    <field
                    name="wallee_application_user_id"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')], 'required': [('use_payment_terminal', '=', 'payworld_wallee')]}"
                />
                <field
                    name="wallee_authentication_key"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')], 'required': [('use_payment_terminal', '=', 'payworld_wallee')]}"
                    password="True"
                />
                <field
                    name="wallee_terminal_identifier"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')], 'required': [('use_payment_terminal', '=', 'payworld_wallee')]}"
                />
                <field
                    name="wallee_language"
                    attrs="{'invisible': [('use_payment_terminal', '!=', 'payworld_wallee')]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
