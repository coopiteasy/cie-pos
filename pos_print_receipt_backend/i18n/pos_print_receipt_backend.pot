#. module: pos_print_receipt_backend
#: model:mail.template,body_html:pos_print_receipt_backend.email_template_pos_order_receipt
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-if=\"object.partner_id and object.partner_id.name\" t-out=\"object.partner_id.name\"></t>\n"
"                        <t t-else=\"\">customer</t>\n"
"                        <t t-if=\"object.partner_id and object.partner_id.parent_id\">\n"
"                            (<t t-out=\"object.partner_id.parent_id.name\"></t>)\n"
"                        </t>,\n"
"                        <br><br>\n"
"                        Here is your\n"
"                        <t t-if=\"object.pos_reference\">\n"
"                            receipt\n"
"                            <strong t-out=\"object.pos_reference\"></strong>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            receipt\n"
"                        </t>\n"
"                        <t t-if=\"object.name\">\n"
"                            (with order reference: <t t-out=\"object.name\"></t>)\n"
"                        </t>\n"
"                        amounting in\n"
"                        <strong t-out=\"format_amount(object.amount_total, object.company_id.currency_id)\"></strong>\n"
"                        from <t t-out=\"object.company_id.name\"></t>.\n"
"                        <t t-if=\"object.state in ('paid', 'done', 'invoiced')\">\n"
"                            This order is already paid.\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Please remit payment at your earliest convenience.\n"
"                        </t>\n"
"                        <br><br>\n"
"                        Do not hesitate to contact us if you have any question.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

