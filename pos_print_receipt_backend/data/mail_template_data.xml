<?xml version="1.0" ?>
<odoo>

    <!-- Mail template are declared in a NOUPDATE block
         so users can freely customize/delete them -->
    <data noupdate="1">
        <!--Email template -->
        <record id="email_template_pos_order_receipt" model="mail.template">
            <field name="name">POS Order Receipt: Send by email</field>
            <field name="model_id" ref="point_of_sale.model_pos_order" />
            <field name="email_from">{{ object.user_id.email_formatted }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field
                name="subject"
            >{{ object.company_id.name }} POS Order (Receipt Ref {{ object.pos_reference or 'n/a' }})</field>
            <field name="description">Send POS receipt by email</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t
                            t-if="object.partner_id and object.partner_id.name"
                            t-out="object.partner_id.name"
                        />
                        <t t-else="">customer</t>
                        <t t-if="object.partner_id and object.partner_id.parent_id">
                            (<t t-out="object.partner_id.parent_id.name" />)
                        </t>,
                        <br /><br />
                        Here is your
                        <t t-if="object.pos_reference">
                            receipt
                            <strong t-out="object.pos_reference" />
                        </t>
                        <t t-else="">
                            receipt
                        </t>
                        <t t-if="object.name">
                            (with order reference: <t t-out="object.name" />)
                        </t>
                        amounting in
                        <strong
                            t-out="format_amount(object.amount_total, object.company_id.currency_id)"
                        />
                        from <t t-out="object.company_id.name" />.
                        <t t-if="object.state in ('paid', 'done', 'invoiced')">
                            This order is already paid.
                        </t>
                        <t t-else="">
                            Please remit payment at your earliest convenience.
                        </t>
                        <br /><br />
                        Do not hesitate to contact us if you have any question.
                    </p>
                </div>
            </field>
            <field name="report_template" ref="action_report_receipt" />
            <field
                name="report_name"
            >Receipt_{{ (object.pos_reference or '').replace('/','_') }}{{ object.state == 'draft' and '_draft' or '' }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>
