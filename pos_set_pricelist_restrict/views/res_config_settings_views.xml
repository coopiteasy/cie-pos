<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos_pricelist_restrict</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('price_control')]" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    title="Only users with Manager access rights for PoS app can change the pricelist."
                >
                    <div class="o_setting_left_pane">
                        <field name="pos_restrict_pricelist_control" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_restrict_pricelist_control"
                            string="Pricelist Control"
                        />
                        <div class="text-muted">
                            Restrict pricelist changes to managers
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
